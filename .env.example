# Server-only. Never use VITE_OPENAI_API_KEY or put secrets in client code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
HOST=127.0.0.1
# Set true behind HTTPS; reverse proxy should preserve Host.
COOKIE_SECURE=false
# For a separate frontend, allow exactly its origin. Prefer same-origin hosting.
# ALLOWED_ORIGIN=http://localhost:5173
# Client build-time only: optional backend origin (same-site HTTPS recommended).
# VITE_API_URL=https://chat.example.com
